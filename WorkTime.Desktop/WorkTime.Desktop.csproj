<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      GUI-подсистема WinExe нужна только Windows-сборке. Привязка идёт к RID,
      а не к ОС сборки: иначе публикация `-r linux-x64` с Windows породила бы
      WinExe-заголовок в Linux-бинаре.
    -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' OR $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Инвариантная локализация: стабильная сборка на Windows и RED OS без ICU -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local-first слой (SQLite + SyncQueue) общий с консольным клиентом -->
    <ProjectReference Include="..\WorkTime.Client\WorkTime.Client.csproj" />
  </ItemGroup>

</Project>
